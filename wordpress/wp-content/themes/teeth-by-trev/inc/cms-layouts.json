    "html": "<section class=\"bg-onyx py-28 lg:py-40\"><div class=\"mx-auto max-w-7xl px-6 lg:px-10\"><div class=\"reveal mx-auto max-w-2xl text-center\"><p class=\"mb-6 text-[0.6rem] uppercase tracking-[0.34em] text-gold/70\">{{content_005}}</p><h2 class=\"font-serif text-4xl font-light leading-[1.1] text-ivory sm:text-5xl\">{{content_006}}</h2></div>{{cms_items}}</div></section>",
